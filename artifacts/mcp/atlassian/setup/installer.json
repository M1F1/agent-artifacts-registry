{"artifact":"mcp/atlassian","capabilities":["keychain","filesystem"],"help_urls":[{"label":"Atlassian API-token authentication","url":"https://support.atlassian.com/atlassian-rovo-mcp-server/docs/configuring-authentication-via-api-token/"},{"label":"Atlassian OAuth setup (recommended for interactive use)","url":"https://support.atlassian.com/atlassian-rovo-mcp-server/docs/getting-started-with-the-atlassian-remote-mcp-server/"}],"inputs":[{"help_url":"https://support.atlassian.com/atlassian-rovo-mcp-server/docs/configuring-authentication-via-api-token/","id":"api_key","prompt":"Paste the Atlassian service-account API key","type":"secret"}],"platforms":["darwin"],"protocol_version":2,"purpose":"Configure optional non-interactive Atlassian service-account API-key access.","required_tools":["/usr/bin/security"],"schema_version":2,"steps":[{"id":"keychain","use":"macos-keychain.store@1","with":{"account":"default","input":"api_key","service":"aart/mcp/atlassian/service-account-api-key"}},{"id":"shell","use":"shell.env-from-keychain@1","with":{"file":"~/.zshrc","variables":{"ATLASSIAN_API_KEY":{"account":"default","service":"aart/mcp/atlassian/service-account-api-key"}}}},{"id":"restart","use":"restart.notice@1","with":{"message":"Open a new shell and restart the harness before using Atlassian Rovo MCP."}}]}
